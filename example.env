# Server Configuration
PORT=8080
ENV=development
API_BASE_PATH=/api/v1

# PostgreSQL Database Configuration (pgxpool)
DATABASE_URL=postgres://user:password@host:port/multitenant_db?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_HEALTH_CHECK_PERIOD=1m

# JWT Authentication
JWT_SECRET=neurealm-multitenant-secret-key-must-be-at-least-32-bytes!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# In-Memory Permission Cache
CACHE_TTL=5m
CACHE_CLEANUP_INTERVAL=10m
