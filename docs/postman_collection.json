			"name": "Auth",
			"item": [
				{
					"name": "Login (Acme Corp)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.success && json.data && json.data.access_token) {",
									"    pm.collectionVariables.set('accessToken', json.data.access_token);",
									"    pm.collectionVariables.set('refreshToken', json.data.refresh_token);",
									"    pm.collectionVariables.set('tenantId', json.data.tenant.id);",
									"    pm.collectionVariables.set('userId', json.data.user.id);",
									"    console.log('Saved tokens & IDs to variables');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@multitenant.com\",\n  \"password\": \"Password123!\",\n  \"tenant_code\": \"acme-corp\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
