{
  "components": {
    "schemas": {
      "ApiResponse": {
        "properties": {
          "data": {
            "type": "object"
          },
          "message": {
            "example": "Operation completed successfully",
            "type": "string"
          },
          "success": {
            "example": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "AuditLog": {
        "properties": {
          "action": {
            "example": "user:create",
            "type": "string"
          },
          "actor_email": {
            "example": "admin@acme.com",
            "type": "string"
          },
          "actor_id": {
            "format": "uuid",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "target_id": {
            "example": "u0000000-0000-0000-0000-000000000002",
            "type": "string"
          },
          "target_type": {
            "example": "user",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AuthTokens": {
        "properties": {
          "access_token": {
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "type": "string"
          },
          "expires_in": {
            "example": 900,
            "type": "integer"
          },
          "permissions": {
            "example": [
              "user:create",
              "user:read"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "refresh_token": {
            "example": "9a7b3c2d1e...",
            "type": "string"
          },
          "roles": {
            "example": [
              "Admin"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          },
          "token_type": {
            "example": "Bearer",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "example": "FORBIDDEN",
                "type": "string"
              },
              "details": {
                "type": "object"
              },
              "message": {
                "example": "forbidden: insufficient permissions",
                "type": "string"
              }
            },
            "type": "object"
          },
          "success": {
            "example": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "PaginatedResponse": {
        "properties": {
          "data": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "pagination": {
            "properties": {
              "limit": {
                "example": 20,
                "type": "integer"
              },
              "page": {
                "example": 1,
                "type": "integer"
              },
              "total": {
                "example": 42,
                "type": "integer"
              },
              "total_pages": {
                "example": 3,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "success": {
            "example": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Permission": {
        "properties": {
          "action": {
            "example": "create",
            "type": "string"
          },
          "description": {
            "example": "Create users in tenant",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "resource": {
            "example": "user",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Role": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "example": "Editorial content manager",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "is_system": {
            "example": false,
            "type": "boolean"
          },
          "name": {
            "example": "Editor",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "type": "array"
          },
          "tenant_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Tenant": {
        "properties": {
          "code": {
            "example": "acme-corp",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "example": "Acme Corporation",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "suspended"
            ],
            "example": "active",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "example": "user@example.com",
            "format": "email",
            "type": "string"
          },
          "first_name": {
            "example": "Jane",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "is_platform_admin": {
            "example": false,
            "type": "boolean"
          },
          "last_name": {
            "example": "Doe",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array"
          },
          "tenant_id": {
            "format": "uuid",
            "type": "string"
          },
          "tenant_status": {
            "enum": [
              "active",
              "suspended"
            ],
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Enter the tenant-scoped JWT access token obtained from /api/v1/auth/login.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Production-grade Multi-Tenant User Management System built with Go and PostgreSQL (pgxpool).\nFeatures tenant isolation (shared DB with tenant_id, cross-tenant returns 404), RBAC permissions (resource:action),\nJWT authentication with tenant-scoped access \u0026 refresh tokens, in-memory high-throughput permission caching, and immutable audit logs.\n",
    "title": "Multi-Tenant User Management System API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/audit-logs": {
      "get": {
        "description": "Requires 'audit:read' permission. Strictly tenant-scoped audit trail (actor, action, target, metadata, timestamp).",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit logs"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Query Audit Logs"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Authenticates user using email and password. Scopes session to specified tenant_code or prompts tenant selection if user belongs to multiple tenants.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "example": "alice@multitenant.com",
                    "format": "email",
                    "type": "string"
                  },
                  "password": {
                    "example": "Password123!",
                    "type": "string"
                  },
                  "tenant_code": {
                    "example": "acme-corp",
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Login successful or tenant selection required"
          },
          "401": {
            "description": "Invalid email or password"
          },
          "403": {
            "description": "Tenant or user suspended"
          }
        },
        "summary": "User Login"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revokes session refresh token and invalidates cached permissions.",
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "User Logout"
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Returns current authenticated user, active tenant scope, assigned roles, and effective permissions.",
        "responses": {
          "200": {
            "description": "Profile retrieved successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Current Profile"
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Exchanges a valid refresh token for a fresh access token and rotated refresh token.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "refresh_token"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token refreshed successfully"
          },
          "401": {
            "description": "Invalid, revoked or expired refresh token"
          }
        },
        "summary": "Refresh Access Token"
      }
    },
    "/api/v1/auth/switch-tenant": {
      "post": {
        "description": "Authenticated user switches session context to another tenant they belong to.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "tenant_code": {
                    "example": "globex",
                    "type": "string"
                  }
                },
                "required": [
                  "tenant_code"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Switched tenant successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Switch Tenant"
      }
    },
    "/api/v1/permissions": {
      "get": {
        "description": "Requires 'role:read' permission. Lists system resource:action permissions.",
        "responses": {
          "200": {
            "description": "Available permissions list"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Available Permissions"
      }
    },
    "/api/v1/roles": {
      "get": {
        "description": "Requires 'role:read' permission.",
        "responses": {
          "200": {
            "description": "Paginated roles list"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Tenant Roles"
      },
      "post": {
        "description": "Requires 'role:create' permission.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "example": "Manages billing and subscriptions",
                    "type": "string"
                  },
                  "name": {
                    "example": "BillingManager",
                    "type": "string"
                  },
                  "permission_ids": {
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Role created successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create Tenant-Specific Role"
      }
    },
    "/api/v1/roles/{id}": {
      "delete": {
        "description": "Requires 'role:delete' permission. Cannot delete system roles.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role deleted"
          },
          "400": {
            "description": "Cannot delete system admin role"
          },
          "404": {
            "description": "Role not found in current tenant"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Delete Role"
      },
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role details"
          },
          "404": {
            "description": "Role not found in current tenant"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Role Details"
      },
      "put": {
        "description": "Requires 'role:update' permission.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Role updated"
          },
          "404": {
            "description": "Role not found in current tenant"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Update Role"
      }
    },
    "/api/v1/roles/{id}/permissions": {
      "post": {
        "description": "Requires 'role:update' permission. Mappings of resource:action permissions to role.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "permission_ids": {
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "permission_ids"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Permissions assigned to role"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Assign Permissions to Role"
      }
    },
    "/api/v1/tenants": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated tenants list"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Tenants"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "example": "cyberdyne",
                    "type": "string"
                  },
                  "name": {
                    "example": "Cyberdyne Systems",
                    "type": "string"
                  },
                  "status": {
                    "default": "active",
                    "enum": [
                      "active",
                      "suspended"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "code"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Tenant created successfully"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create Organization / Tenant"
      }
    },
    "/api/v1/tenants/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant details"
          },
          "404": {
            "description": "Tenant not found or cross-tenant access denied"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Tenant Details"
      },
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "active",
                      "suspended"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "status"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tenant updated successfully"
          },
          "404": {
            "description": "Tenant not found or cross-tenant access denied"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Update Tenant"
      }
    },
    "/api/v1/users": {
      "get": {
        "description": "Requires 'user:read' permission. Excludes soft-deleted users.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated users list in tenant"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Users in Tenant"
      },
      "post": {
        "description": "Requires 'user:create' permission. Creates or links user to current tenant.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "format": "email",
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "password": {
                    "format": "password",
                    "minLength": 8,
                    "type": "string"
                  },
                  "role_ids": {
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "first_name",
                  "last_name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created in tenant"
          },
          "403": {
            "description": "Insufficient permissions (missing user:create)"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create User in Tenant"
      }
    },
    "/api/v1/users/{id}": {
      "delete": {
        "description": "Requires 'user:delete' permission. Soft deletes user from tenant.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User soft-deleted"
          },
          "404": {
            "description": "User not found in this tenant"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Soft Delete User"
      },
      "get": {
        "description": "Requires 'user:read' permission. Returns 404 if user belongs to another tenant or is soft-deleted.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details"
          },
          "404": {
            "description": "User not found in this tenant (cross-tenant protection)"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get User in Tenant"
      },
      "put": {
        "description": "Requires 'user:update' permission.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "active",
                      "suspended"
                    ],
